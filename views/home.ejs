<% layout("/layouts/boilerplate") %>

<div class="container mt-4">

  <div class="text-center p-5 mb-4 bg-light rounded">
    <h1>Find your next stay</h1>
    <p>Discover amazing places at best price</p>

    <form action="/listings" method="GET" class="d-flex justify-content-center mt-3">
      <input 
        type="text" 
        name="q" 
        class="form-control w-50 me-2"
        placeholder="Search destinations..."
      >
      <button class="btn btn-danger">Search</button>
    </form>
  </div>

  <h3 class="mb-3">Featured Listings</h3>

  <div class="row">
    <% listings.forEach(listing => { %>
      <div class="col-md-4 mb-4">
        <a href="/listings/<%= listing._id %>" class="listing-link">
          <div class="card listing-card">
            <img src="<%= listing.image.url %>" class="card-img-top">
            <div class="card-body">
              <p><b><%= listing.title %></b></p>
              <p>₹<%= listing.price %> / night</p>
            </div>
          </div>
        </a>
      </div>
    <% }) %>
  </div>

</div>