<% layout("/layouts/boilerplate") %>

<div class="container show-container mt-4">

    <!-- Title -->
    <h3 class="mb-3"><%= listing.title %></h3>

    <!-- Card -->
    <div class="card listing-card mb-3">
        <img 
            src="<%= listing.image?.url || 'https://via.placeholder.com/400' %>" 
            class="card-img-top show-img"
            alt="listing image"
        >

        <div class="card-body">
            <p>Owned by <i><%= listing.owner.username %></i></p>
            <p><%= listing.description %></p>
            <p><b>₹<%= listing.price?.toLocaleString("en-IN") || "N/A" %></b></p>
            <p><%= listing.location %>, <%= listing.country %></p>
        </div>
    </div>

    <!-- Buttons -->
    <% if(currUser && listing.owner._id.equals(currUser._id)) { %>
    <div class="btns mb-4">
        <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark">Edit</a>

        <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
            <button class="btn btn-danger">Delete</button>
        </form>
    </div>
    <% } %>

    <!-- MAP -->
    <h4>Where you'll be</h4>
    <div id="map"></div>

    <!-- Coordinates Script -->
    <script>
        const coordinates = <%- JSON.stringify(listing.geometry?.coordinates || [77.2090, 28.6139]) %>;
        const listingLocation = "<%= listing.location %>";
    </script>

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

    <!-- Map Script -->
    <script src="/js/map.js"></script>

    <!-- Review Form -->
    <hr>
    <% if(currUser) { %>
    <h4>Leave a Review</h4>

    <form action="/listings/<%=listing._id%>/reviews" method="POST" class="needs-validation">

    <div class="mb-3">
  <label class="form-label">Rating</label>

  <fieldset class="starability-slot">

    <!-- Hidden default (no selection) -->
    <input type="radio" name="review[rating]" value="" checked hidden />

    <input type="radio" id="rate1" name="review[rating]" value="1" />
    <label for="rate1">1 star</label>

    <input type="radio" id="rate2" name="review[rating]" value="2" />
    <label for="rate2">2 stars</label>

    <input type="radio" id="rate3" name="review[rating]" value="3" />
    <label for="rate3">3 stars</label>

    <input type="radio" id="rate4" name="review[rating]" value="4" />
    <label for="rate4">4 stars</label>

    <input type="radio" id="rate5" name="review[rating]" value="5" />
    <label for="rate5">5 stars</label>

  </fieldset>
</div>

        <div class="mb-3">
            <textarea 
                name="review[comment]" 
                class="form-control" 
                rows="4" 
                placeholder="Write your review..." 
                required
            ></textarea>
        </div>

        <button class="btn btn-outline-dark">Submit</button>
    </form>
    <% } %>

    <!-- Reviews -->
    <% if (listing.reviews && listing.reviews.length) { %>
    <hr>
    <h4>All Reviews</h4>

    <div class="row g-3">
        <% for (let review of listing.reviews) { %>
        <div class="col-12 col-md-6">
            <div class="card review-card">
                <div class="card-body">

                    <h6>@<%= review.author.username %></h6>

                    <p class="starability-result" data-rating="<%= review.rating %>"></p>

                    <p class="small">
                        <b>Posted:</b>
                        <%= new Date(review.createdAt).toLocaleString("en-IN") %>
                    </p>

                    <p><%= review.comment %></p>

                    <form action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE" method="POST">
                        <button class="btn btn-sm btn-dark">Delete</button>
                    </form>

                </div>
            </div>
        </div>
        <% } %>
    </div>
    <% } %>

</div>