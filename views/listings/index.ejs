<%layout("/layouts/boilerplate")%>

    <style>
        :root {
            --airbnb-pink: #ff385c;
            --airbnb-dark: #222222;
            --airbnb-gray: #717171;
        }
        
        .filter-bar {
            position: sticky;
            top: 80px;
            background: white;
            z-index: 100;
            padding: 1rem 0;
            border-bottom: 1px solid #eee;
        }
        
        .filter-container {
            display: flex;
            gap: 2rem;
            overflow-x: auto;
            padding: 0.5rem 0;
            scrollbar-width: none;
            -ms-overflow-style: none;
        
        }
        
        .filter-container::-webkit-scrollbar {
            display: none;
        }
        
        .filter-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.5rem;
            min-width: 64px;
            padding: 0.5rem;
            border-bottom: 2px solid transparent;
            opacity: 0.65;
            transition: all 0.2s;
            cursor: pointer;
            white-space: nowrap;
        }
        
        .filter-item:hover {
            opacity: 1;
            border-bottom-color: var(--airbnb-dark);
        }
        
        .filter-item i {
            font-size: 1.5rem;
        }
        
        .filter-item p {
            font-size: 0.75rem;
            font-weight: 500;
            margin: 0;
        }
        
        .tax-toggle {
            border: 1px solid var(--airbnb-dark);
            border-radius: 2rem;
            padding: 0.5rem 1rem;
            display: flex;
            align-items: center;
            white-space: nowrap;
            cursor: pointer;
            transition: all 0.2s;
            min-width: fit-content;
        }
        
        .tax-toggle:hover {
            background: #f7f7f7;
        }
        
        .tax-info {
            display: none;
        }
        
        .listing-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
            gap: 1.5rem;
            padding: 1.5rem 0;
        }
        
        .listing-card {
            text-decoration: none;
            color: inherit;
            display: block;
        }
        
        .card-image-container {
            position: relative;
            border-radius: 1rem;
            overflow: hidden;
            aspect-ratio: 1 / 0.95;
            background: #f7f7f7;
        }
        
        .card-image-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s ease;
        }
        
        .listing-card:hover .card-image-container img {
            transform: scale(1.05);
        }
        
        .wishlist-btn {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: rgba(255, 255, 255, 0.9);
            border: none;
            border-radius: 50%;
            width: 2rem;
            height: 2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: transform 0.2s;
            z-index: 10;
        }
        
        .wishlist-btn:hover {
            transform: scale(1.1);
        }
        
        .wishlist-btn i {
            color: var(--airbnb-pink);
        }
        
        .card-content {
            padding-top: 0.75rem;
        }
        
        .card-location {
            font-size: 0.95rem;
            font-weight: 600;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .card-distance {
            font-size: 0.9rem;
            color: var(--airbnb-gray);
            margin-top: 0.25rem;
        }
        
        .card-dates {
            font-size: 0.9rem;
            color: var(--airbnb-gray);
            margin-top: 0.25rem;
        }
        
        .card-price {
            font-size: 0.95rem;
            margin-top: 0.5rem;
            display: flex;
            align-items: baseline;
            gap: 0.25rem;
        }
        
        .card-price .amount {
            font-weight: 600;
        }
        
        .card-price .per-night {
            color: var(--airbnb-gray);
        }
        
        .card-price .tax-info {
            color: var(--airbnb-gray);
            font-size: 0.85rem;
        }

        .card-rating {
            display: flex;
            align-items: center;
            gap: 0.25rem;
        }
        
        .card-rating i {
            font-size: 0.8rem;
        }

        @media (max-width: 768px) {
            .listing-grid {
                grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
                gap: 1rem;
            }
            
            .filter-container {
                gap: 1rem;
            }
            
            .filter-item {
                min-width: 56px;
            }
            
            .filter-item i {
                font-size: 1.25rem;
            }
            
            .tax-toggle {
                display: none;
            }
        }
    </style>

    <div class="filter-bar">
        <div class="container-fluid px-4">
            <div class="d-flex align-items-center justify-content-between">
                <div class="filter-container flex-grow-1">
                    <div class="filter-item">
                        <i class="fa-solid fa-fire"></i>
                        <p>Trending</p>
                    </div>
                    <div class="filter-item">
                        <i class="fa-solid fa-bed"></i>
                        <p>Rooms</p>
                    </div>
                    <div class="filter-item">
                        <i class="fa-solid fa-mountain-city"></i>
                        <p>Iconic cities</p>
                    </div>
                    <div class="filter-item">
                        <i class="fa-solid fa-mountain"></i>
                        <p>Mountains</p>
                    </div>
                    <div class="filter-item">
                        <i class="fa-brands fa-fort-awesome"></i>
                        <p>Castles</p>
                    </div>
                    <div class="filter-item">
                        <i class="fa-solid fa-person-swimming"></i>
                        <p>Amazing Pools</p>
                    </div>
                    <div class="filter-item">
                        <i class="fa-solid fa-campground"></i>
                        <p>Camping</p>
                    </div>
                    <div class="filter-item">
                        <i class="fa-solid fa-cow"></i>
                        <p>Farms</p>
                    </div>
                    <div class="filter-item">
                        <i class="fa-solid fa-snowflake"></i>
                        <p>Arctic</p>
                    </div>
                    <div class="filter-item">
                        <i class="fa-solid fa-landmark-dome"></i>
                        <p>Domes</p>
                    </div>
                    <div class="filter-item">
                        <i class="fa-solid fa-sailboat"></i>
                        <p>Boats</p>
                    </div>
                </div>
                <div class="tax-toggle ms-3">
                    <div class="form-check-reverse form-switch d-flex align-items-center">
                        <input class="form-check-input me-2" type="checkbox" role="switch" id="flexSwitchCheckDefault" style="margin: 0; transform: scale(1.2);">
                        <label class="form-check-label" for="flexSwitchCheckDefault" style="margin: 0; font-size: 0.9rem;">Display total after taxes</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid px-4">
        <div class="listing-grid">
            <%for(let listing of allListings){%>
                <a href="/listings/<%=listing._id%>" class="listing-link listing-card">
                    <div class="card-image-container">
                        <img src="<%=listing.image.url%>" alt="listing_image" loading="lazy">
                    </div>
                    <div class="card-content">
                        <div class="card-location">
                            <span><%=listing.location || "Unknown Location"%></span>
                            <div class="card-rating">
                                <i class="fa-solid fa-star"></i>
                                <span><%=listing.rating || "New"%></span>
                            </div>
                        </div>
                        <div class="card-distance">Near by destination</div>
                        <div class="card-dates">Add dates</div>
                        <div class="card-price">
                            <span class="amount">&#8377; <%=listing.price ? listing.price.toLocaleString("en-IN"):"N/A"%></span>
                            <span class="per-night">/night</span>
                            <span class="tax-info">+18% GST</span>
                        </div>
                    </div>
                </a>
            <%}%>
        </div>
    </div>

    <script>
        let taxSwitch = document.getElementById("flexSwitchCheckDefault");
        taxSwitch.addEventListener("click", function() {
            let taxInfo = document.getElementsByClassName("tax-info");
            for (let info of taxInfo) {
                if (this.checked) {
                    info.style.display = "inline";
                } else {
                    info.style.display = "none";
                }
            }
        });
    </script>